# OpenCode dark theme
background = "#0a0a0a"
foreground = "#eeeeee"
selection-background = "#282828"
selection-foreground = "#eeeeee"

palette = 0=#1e1e1e
palette = 1=#e06c75
palette = 2=#7fd88f
palette = 3=#e5c07b
palette = 4=#5c9cf5
palette = 5=#9d7cd8
palette = 6=#56b6c2
palette = 7=#eeeeee
palette = 8=#808080
palette = 9=#e06c75
palette = 10=#7fd88f
palette = 11=#f5a742
palette = 12=#5c9cf5
palette = 13=#9d7cd8
palette = 14=#56b6c2
palette = 15=#eeeeee

cursor-style = "bar"
cursor-color = "#ffffff"
cursor-text = cell-background

command = /opt/homebrew/bin/fish

mouse-hide-while-typing = true

# font-family = "Geist Mono"
# font-family = "Source Code Pro"
font-feature = -calt, -liga, -dlig
font-size = 12

unfocused-split-opacity = 1

unfocused-split-opacity = 1.0

keybind = super+d=new_split:right
keybind = super+shift+d=new_split:down

keybind = super+h=goto_split:left
keybind = super+j=goto_split:down
keybind = super+k=goto_split:up
keybind = super+l=goto_split:right

keybind = super+shift+h=resize_split:left,30
keybind = super+shift+j=resize_split:down,30
keybind = super+shift+k=resize_split:up,30
keybind = super+shift+l=resize_split:right,30

keybind = super+w=close_surface
