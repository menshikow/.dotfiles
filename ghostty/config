# Hide pointer while typing and make text cursor invisible
mouse-hide-while-typing = true

font-feature = -dlig
font-feature = -liga
font-feature = -calt

font-size = 17

font-family = "IoskeleyMonoTerm Nerd Font"

# font-family = "JetBrains Mono"

# monochrome theme 

# background = #000000
# foreground = #E6E6E6
# cursor-color = #F2F0EF
# selection-background = #404040
# selection-foreground = #F2F2F2

theme = Black Metal (Mayhem)

# Split panes (macOS)
keybind = super+d=new_split:right
keybind = super+shift+d=new_split:down

# Vim-style pane navigation
keybind = super+h=goto_split:left
keybind = super+j=goto_split:down
keybind = super+k=goto_split:up
keybind = super+l=goto_split:right

# Vim-style pane resizing
keybind = super+shift+h=resize_split:left,30
keybind = super+shift+j=resize_split:down,30
keybind = super+shift+k=resize_split:up,30
keybind = super+shift+l=resize_split:right,30

# Close focused pane
keybind = super+w=close_surface

cursor-color = #52ae6f
cursor-text = #1e1e1e
