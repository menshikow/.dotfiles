{
  "buffer_font_features": {
    "calt": false
  },
  "buffer_font_family": ".ZedMono",
  "cursor_blink": false,
  "prettier": {
    "allowed": false
  },
  "disable_ai": true,
  "show_edit_predictions": false,
  "project_panel": {
    "dock": "right"
  },
  "cursor_shape": "block",
  "ui_font_family": ".ZedSans",
  "icon_theme": "Symbols Icon Theme",
  "vim_mode": true,
  "ui_font_size": 16,
  "buffer_font_size": 19.0,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Tokyo Night"
  },
  "git": {
    "inline_blame": {
      "enabled": false
    }
  },
  "scrollbar": {
    "show": "never"
  },
  "relative_line_numbers": true
}
