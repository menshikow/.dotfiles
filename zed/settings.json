{
  "current_line_highlight": "none",
  "icon_theme": {
    "mode": "system",
    "light": "Symbols Icon Theme",
    "dark": "Symbols Icon Theme"
  },
  "buffer_font_features": {
    "calt": false
  },
  "buffer_font_family": "GeistMono Nerd Font",
  "cursor_blink": false,
  "prettier": {
    "allowed": false
  },
  "disable_ai": true,
  "show_edit_predictions": false,
  "project_panel": {
    "dock": "right"
  },
  // "cursor_shape": "block",
  "ui_font_family": "GeistMono Nerd Font Mono",
  "vim_mode": true,
  "ui_font_size": 15.0,
  "buffer_font_size": 18.0,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Kanagawa Dragon - No Italics"
  },
  "git": {
    "inline_blame": {
      "enabled": false
    }
  },
  "scrollbar": {
    "show": "never"
  },
  "relative_line_numbers": "enabled"
  // "use_auto_surround": false,
  // "use_autoclose": false
}
